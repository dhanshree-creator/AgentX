# Copy to .env and fill in real values. Never commit your .env file.

# --- LLM provider (OpenAI-compatible function calling) ---
# BYOK: endpoint + key must BOTH be provided by the user. No key is bundled.
AGENTX_PROVIDER=provider_a
AGENTX_BASE_URL=https://api.provider-a.example/v1
AGENTX_API_KEY=
AGENTX_MODEL=provider-a-latest
# Allows insecure http:// base URLs ONLY if explicitly true (not recommended):
AGENTX_ALLOW_INSECURE_BASE_URL=false
